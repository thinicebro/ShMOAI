#include "include.cuh"
#include "source/bootstrapping/BatchBootstrap.cuh"
#include <set>

using namespace std;
using namespace phantom;
using namespace moai;

const int num_X = 256;
const int num_row = 128;
// runtime layer width: 768 = full BERT layer (needs a >=48GB GPU), 192 = the
// quarter-width run that fits 16GB. Weight/input files always store the full
// width and are sliced on read (first num_col / num_inter entries per row).
int num_col = 768;
int num_inter = 3072;
const int file_num_col = 768;
const int file_num_inter = 3072;
const int file_num_head = 12;
const double sqrt_d = 8.0;
int num_input = 11;

vector<vector<vector<double>>> input_x(num_X, vector<vector<double>>(num_row, vector<double>(num_col, 0)));

// paras for attention block
int col_W = 64;
int num_head = 12;
vector<vector<vector<double>>> WQ(num_head, vector<vector<double>>(num_col, vector<double>(col_W, 0.0)));
vector<vector<vector<double>>> WK(num_head, vector<vector<double>>(num_col, vector<double>(col_W, 0.0)));
vector<vector<vector<double>>> WV(num_head, vector<vector<double>>(num_col, vector<double>(col_W, 0.0)));

vector<vector<double>> bQ(num_head, vector<double>(col_W, 0.0));
vector<vector<double>> bK(num_head, vector<double>(col_W, 0.0));
vector<vector<double>> bV(num_head, vector<double>(col_W, 0.0));

vector<vector<double>> selfoutput(num_col, vector<double>(num_col, 0.0));
vector<double> selfoutput_bias(num_col, 0.0);
vector<double> layernorm1_gamma(num_col, 0.0);
vector<double> layernorm1_beta(num_col, 0.0);

vector<vector<double>> inter_weight(num_col, vector<double>(num_inter, 0.0));
vector<double> inter_bias(num_inter, 0.0);
vector<vector<double>> final_weight(num_inter, vector<double>(num_col, 0.0));
vector<double> final_bias(num_col, 0.0);
vector<double> layernorm2_gamma(num_col, 0.0);
vector<double> layernorm2_beta(num_col, 0.0);

// resize all weight/input buffers to the current num_col/num_inter/num_head
void resize_param_vectors()
{
    input_x.assign(num_X, vector<vector<double>>(num_row, vector<double>(num_col, 0)));
    WQ.assign(num_head, vector<vector<double>>(num_col, vector<double>(col_W, 0.0)));
    WK.assign(num_head, vector<vector<double>>(num_col, vector<double>(col_W, 0.0)));
    WV.assign(num_head, vector<vector<double>>(num_col, vector<double>(col_W, 0.0)));
    bQ.assign(num_head, vector<double>(col_W, 0.0));
    bK.assign(num_head, vector<double>(col_W, 0.0));
    bV.assign(num_head, vector<double>(col_W, 0.0));
    selfoutput.assign(num_col, vector<double>(num_col, 0.0));
    selfoutput_bias.assign(num_col, 0.0);
    layernorm1_gamma.assign(num_col, 0.0);
    layernorm1_beta.assign(num_col, 0.0);
    inter_weight.assign(num_col, vector<double>(num_inter, 0.0));
    inter_bias.assign(num_inter, 0.0);
    final_weight.assign(num_inter, vector<double>(num_col, 0.0));
    final_bias.assign(num_col, 0.0);
    layernorm2_gamma.assign(num_col, 0.0);
    layernorm2_beta.assign(num_col, 0.0);
}

// read one comma-separated row of file_width values, keeping the first keep
// (dst may be null with keep = 0 to skip the row). Mirrors the original
// per-row comma layout: no separator after the row's last value.
static void read_row_sliced(ifstream &fin, double *dst, int keep, int file_width)
{
    char a;
    double v;
    for (int j = 0; j < file_width; ++j)
    {
        fin >> v;
        if (j < keep)
            dst[j] = v;
        if (j + 1 < file_width)
            fin >> a;
    }
}

static void skip_rows(ifstream &fin, long rows, int file_width)
{
    for (long r = 0; r < rows; ++r)
        read_row_sliced(fin, nullptr, 0, file_width);
}

// whitespace-separated vector: keep the first keep of file_width values
static void read_vec_sliced(ifstream &fin, double *dst, int keep, int file_width)
{
    double v;
    for (int j = 0; j < file_width; ++j)
    {
        fin >> v;
        if (j < keep)
            dst[j] = v;
    }
}

void read_input()
{
    ifstream fin;
    fin.open("att_block_weights/embedded_inputs.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file embedded_inputs.txt" << endl;
    }
    // the test file has 11 input vectors, length of each vector = 768; keep the
    // first num_col entries per vector when running at reduced width
    for (int i = 0; i < num_input; ++i)
    {
        read_row_sliced(fin, input_x[0][i].data(), num_col, file_num_col);
    }
    fin.close();
    // for test
    // cout <<input_x[0][10][0]<<" "<<input_x[0][10][num_col-1]<<endl;
}

void read_weights()
{
    ifstream fin;
    // read matrix Q, size of Q = 12*64*768
    fin.open("att_block_weights/query_weight.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file query_weight.txt" << endl;
    }
    char a;
    vector<double> rowbuf(num_col);
    for (int k = 0; k < num_head; ++k)
    {
        for (int i = 0; i < col_W; ++i)
        {
            read_row_sliced(fin, rowbuf.data(), num_col, file_num_col);
            for (int j = 0; j < num_col; ++j)
                WQ[k][j][i] = rowbuf[j];
        }
    }
    // reduced width uses the first num_head heads only: skip the rest
    skip_rows(fin, (long)(file_num_head - num_head) * col_W, file_num_col);

    fin.close();
    // for test
    // cout <<"WQ last element: "<<WQ[num_head-1][num_col-1][col_W-1]<<endl;

    // Q = Q/sqrt(d')
    for (int k = 0; k < num_head; ++k)
    {
        for (int i = 0; i < num_col; ++i)
        {
            for (int j = 0; j < col_W; ++j)
            {
                WQ[k][i][j] = WQ[k][i][j] / sqrt_d;
            }
        }
    }

    // read matrix K
    fin.open("att_block_weights/key_weight.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file key_weight.txt" << endl;
    }
    for (int k = 0; k < num_head; ++k)
    {
        for (int i = 0; i < col_W; ++i)
        {
            read_row_sliced(fin, rowbuf.data(), num_col, file_num_col);
            for (int j = 0; j < num_col; ++j)
                WK[k][j][i] = rowbuf[j];
        }
    }
    skip_rows(fin, (long)(file_num_head - num_head) * col_W, file_num_col);
    fin.close();
    // for test
    // cout <<"WK last element: "<<WK[num_head-1][num_col-1][col_W-1]<<endl;

    // read matrix V
    fin.open("att_block_weights/value_weight.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file value_weight.txt" << endl;
    }
    for (int k = 0; k < num_head; ++k)
    {
        for (int i = 0; i < col_W; ++i)
        {
            read_row_sliced(fin, rowbuf.data(), num_col, file_num_col);
            for (int j = 0; j < num_col; ++j)
                WV[k][j][i] = rowbuf[j];
        }
    }
    skip_rows(fin, (long)(file_num_head - num_head) * col_W, file_num_col);
    fin.close();
    // for test
    // cout <<"WV last element: "<<WV[num_head-1][num_col-1][col_W-1]<<endl;

    // read self output weight
    fin.open("self_output_weights/self_output_dense_weight.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file self_output_dense_weight.txt" << endl;
    }
    for (int k = 0; k < num_col; ++k)
    {
        read_row_sliced(fin, rowbuf.data(), num_col, file_num_col);
        for (int j = 0; j < num_col; ++j)
            selfoutput[j][k] = rowbuf[j];
    }
    skip_rows(fin, file_num_col - num_col, file_num_col);
    fin.close();
    // cout <<"selfoutput last element: "<<selfoutput[num_col-1][num_col-1]<<endl;

    // read layernorm1 weight
    fin.open("self_output_weights/self_output_LayerNorm_weight.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file self_output_LayerNorm_weight.txt" << endl;
    }
    read_vec_sliced(fin, layernorm1_gamma.data(), num_col, file_num_col);
    fin.close();
    // cout <<"LayerNorm1 last element: "<<layernorm1_gamma[num_col-1]<<endl;
}

void read_bias()
{
    ifstream fin;
    // read bias Q, size of Q = 64
    fin.open("att_block_weights/query_bias.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file query_bias.txt" << endl;
    }
    for (int k = 0; k < num_head; ++k)
    {
        for (int i = 0; i < col_W; ++i)
        {
            fin >> bQ[k][i];
        }
    }
    fin.close();
    // for test
    // cout <<"Q bias last element: "<<bQ[num_head-1][col_W-1]<<endl;

    // bias Q = bias Q / sqrt_d'
    for (int k = 0; k < num_head; ++k)
    {
        for (int i = 0; i < col_W; ++i)
        {
            bQ[k][i] = bQ[k][i] / sqrt_d;
        }
    }

    fin.open("att_block_weights/key_bias.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file key_bias.txt" << endl;
    }
    for (int k = 0; k < num_head; ++k)
    {
        for (int i = 0; i < col_W; ++i)
        {
            fin >> bK[k][i];
        }
    }
    fin.close();
    // for test
    // cout <<"K bias last element: "<<bK[num_head-1][col_W-1]<<endl;

    fin.open("att_block_weights/value_bias.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file value_bias.txt" << endl;
    }
    for (int k = 0; k < num_head; ++k)
    {
        for (int i = 0; i < col_W; ++i)
        {
            fin >> bV[k][i];
        }
    }
    fin.close();
    // for test
    // cout <<"v bias last element: "<<bV[num_head-1][col_W-1]<<endl;

    // read self output bias
    fin.open("self_output_weights/self_output_dense_bias.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file self_output_dense_bias.txt" << endl;
    }
    read_vec_sliced(fin, selfoutput_bias.data(), num_col, file_num_col);
    fin.close();
    // for test
    // cout <<"selfoutput bias last element: "<<selfoutput_bias[num_col-1]<<endl;

    // read layernorm1 weight
    fin.open("self_output_weights/self_output_LayerNorm_bias.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file self_output_LayerNorm_bias.txt" << endl;
    }
    read_vec_sliced(fin, layernorm1_beta.data(), num_col, file_num_col);
    fin.close();
    // cout <<"LayerNorm1 bias last element: "<<layernorm1_beta[num_col-1]<<endl;
}

void read_feed_forward_param()
{
    ifstream fin;
    char a;
    // read inter weight
    fin.open("feed_forward_weights/intermediate_dense_weight.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file intermediate_dense_weight.txt" << endl;
    }
    vector<double> rowbuf2(num_col > num_inter ? num_col : num_inter);
    for (int k = 0; k < num_inter; ++k)
    {
        read_row_sliced(fin, rowbuf2.data(), num_col, file_num_col);
        for (int j = 0; j < num_col; ++j)
            inter_weight[j][k] = rowbuf2[j];
    }
    skip_rows(fin, file_num_inter - num_inter, file_num_col);
    fin.close();
    // cout <<"inter_weight last element: "<<inter_weight[num_col-1][num_inter-1]<<endl;

    // read inter bias
    fin.open("feed_forward_weights/intermediate_dense_bias.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file intermediate_dense_bias.txt" << endl;
    }
    read_vec_sliced(fin, inter_bias.data(), num_inter, file_num_inter);
    fin.close();
    // cout <<"inter_bias last element: "<<inter_bias[num_inter-1]<<endl;

    // read final weight
    fin.open("feed_forward_weights/final_output_dense_weight.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file final_output_dense_weight.txt" << endl;
    }
    for (int k = 0; k < num_col; ++k)
    {
        read_row_sliced(fin, rowbuf2.data(), num_inter, file_num_inter);
        for (int j = 0; j < num_inter; ++j)
            final_weight[j][k] = rowbuf2[j];
    }
    skip_rows(fin, file_num_col - num_col, file_num_inter);
    fin.close();
    // cout <<"final_weight last element: "<<final_weight[num_inter-1][num_col-1]<<endl;

    // read final bias
    fin.open("feed_forward_weights/final_output_dense_bias.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file final_output_dense_bias.txt" << endl;
    }
    read_vec_sliced(fin, final_bias.data(), num_col, file_num_col);
    fin.close();
    // cout <<"final_bias last element: "<<final_bias[num_col-1]<<endl;

    // read layernorm2 weight
    fin.open("feed_forward_weights/final_output_LayerNorm_weight.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file final_output_LayerNorm_weight.txt" << endl;
    }
    read_vec_sliced(fin, layernorm2_gamma.data(), num_col, file_num_col);
    fin.close();
    // cout <<"LayerNorm2 weights last element: "<<layernorm2_gamma[num_col-1]<<endl;

    // read layernorm2 bias
    fin.open("feed_forward_weights/final_output_LayerNorm_bias.txt");
    if (!fin.is_open())
    {
        cout << "Cannot open file final_output_LayerNorm_bias.txt" << endl;
    }
    read_vec_sliced(fin, layernorm2_beta.data(), num_col, file_num_col);
    fin.close();
    // cout <<"LayerNorm2 bias last element: "<<layernorm2_beta[num_col-1]<<endl;
}

// use_shared_a_s2c: replace the four per-ciphertext bootstrap_3 segments with
// batched shared-a S2C-first bootstrapping (16-ct chunks). Requires size_P = 5
// special primes (FmtSwitch needs P >= Q at the 4-prime trigger level).
// amortize_shared_keys: 摊销模式 - cache the per-chunk key material (Sh-Galois
// keys up to an 8 GiB budget + the output-level format key) so only the first
// chunk of the whole layer generates it; 不摊销 (false) regenerates per chunk.
// width: hidden size of the layer (768 = full BERT, 192 = quarter-width run
// that fits a 16GB GPU; weights/inputs are sliced from the full-width files).
void single_layer_test(bool use_shared_a_s2c, int width, bool amortize_shared_keys = false, int num_layers = 1)
{
    num_col = width;
    num_inter = width * 4;
    num_head = width / col_W;
    resize_param_vectors();

    cout << "Task: test one layer of BERT in CKKS scheme (width " << width
         << (use_shared_a_s2c ? ", shared-a S2C-first bootstrap" : ", original bootstrap") << "): " << endl;

    read_input();
    read_weights();
    read_bias();
    read_feed_forward_param();
    cout << "Read input, weights, bias from txt files. " << endl;

    // bootstrapping parameters
    long boundary_K = 25;
    long deg = 59;
    long scale_factor = 2;
    long inverse_deg = 1;

    long logN = 16;
    long loge = 10;

    long logn = 15;
    long sparse_slots = (1 << logn);

    int logp = 46;
    int logq = 51;
    // shared-a S2C-first needs size_P = 5 (FmtSwitch requires P >= Q at the
    // 4-prime trigger level, Q ~ 189 bits). size_P = 5 -> dnum = 7 makes keys
    // ~5x smaller than size_P = 1 (dnum = 35). The full-width original run
    // historically kept the upstream single 58-bit special prime, but with
    // dnum = 35 its Galois/Relin key set alone is ~40GB and 768-wide does not
    // fit a 96GB card; and the quarter-width runs (hence all validated
    // results) already use size_P = 5 for BOTH paths, so full-width now
    // matches that apples-to-apples configuration.
    const bool five_special_primes = true;
    int log_special_prime = five_special_primes ? 51 : 58;
    int num_special_primes = five_special_primes ? 5 : 1;

    int secret_key_hamming_weight = 192;

    // Calculation required
    // remaining_level_att = 18 (upstream MOAI used 15): attention must end at
    // >= 4 primes so the shared-a S2C-first bootstrap (needs exactly lS2C+1 = 4
    // primes) can run at the 1st bootstrap segment. The V path mod-switch point
    // in single_att_block.cuh was raised by the same +3 to keep internal levels
    // aligned. The original bootstrap_3 path is unaffected (its pre-bootstrap
    // mod-switch drops the extra primes anyway).
    int remaining_level_att = 18;
    int boot_level = 14; // >= subsum 1 + coefftoslot 2 + ModReduction 9 + slottocoeff 2
    int total_level_att = remaining_level_att + boot_level;

    int remaining_level = 20;
    int total_level = remaining_level + boot_level;

    // shared-a S2C-first returns from bootstrap at 24 primes, i.e. 3 primes
    // above the original path's 21, so layernorm's first three rescales land
    // on the lowest boot-region primes. layernorm's scale bookkeeping
    // hard-assumes every rescale divides by a ~2^logp prime (it force-resets
    // scale to 2^logp afterwards); rescaling by the 51-bit boot primes makes
    // the true scale drift 5 bits per rescale and compounds into garbage
    // (observed: ln1-out with scale 2^-14). Give those three transition
    // levels 46-bit primes so both layernorms see only logp-sized rescales.
    // The S2C-first bootstrap consumes exactly the top 11 boot primes
    // (coefftoslot 2 + ModReduction 9) plus 3 levels at the bottom before
    // ModRaise, so the 51-bit primes it actually rescales by are untouched;
    // the three resized primes sit below its return level and are only ever
    // consumed by layernorm. Total prime count (hence dnum = 35/5) and every
    // level index are unchanged.
    const int transition_logp_primes = use_shared_a_s2c ? 3 : 0;

    vector<int> coeff_bit_vec;
    coeff_bit_vec.push_back(logq);
    for (int i = 0; i < remaining_level; i++)
    {
        coeff_bit_vec.push_back(logp);
    }
    for (int i = 0; i < transition_logp_primes; i++)
    {
        coeff_bit_vec.push_back(logp);
    }
    for (int i = 0; i < boot_level - transition_logp_primes; i++)
    {
        coeff_bit_vec.push_back(logq);
    }
    for (int i = 0; i < num_special_primes; i++)
    {
        coeff_bit_vec.push_back(log_special_prime);
    }

    EncryptionParameters parms(scheme_type::ckks);

    size_t poly_modulus_degree = (size_t)(1 << logN);
    parms.set_poly_modulus_degree(poly_modulus_degree);
    parms.set_coeff_modulus(CoeffModulus::Create(poly_modulus_degree, coeff_bit_vec));
    parms.set_special_modulus_size(num_special_primes);
    parms.set_secret_key_hamming_weight(secret_key_hamming_weight);
    parms.set_sparse_slots(sparse_slots);
    double scale = pow(2.0, logp);
    // parms.set_coeff_modulus(CoeffModulus::Create(poly_modulus_degree, {60, 40, 40,40, 40,
    //     40,40,40,40,40,40,40,40,40, 40,40,40,40,40,40,40,40,60}));
    // double scale = pow(2.0,40);

    PhantomContext context(parms);
    // cap async mempool retention: phantom sets the release threshold to
    // UINT64_MAX (context.cu:135), hoarding ~79GB and causing OOM later.
    // 2 GiB proved too aggressive: the 12-head attention loop OOM'd in head 3
    // because cross-head temporary reuse lost its pool cache. 16 GiB keeps
    // enough cache for head-to-head reuse while still bounding retention.
    cudaMemPool_t moai_pool;
    cudaDeviceGetDefaultMemPool(&moai_pool, 0);
    uint64_t moai_thr = (uint64_t)16 << 30;
    cudaMemPoolSetAttribute(moai_pool, cudaMemPoolAttrReleaseThreshold, &moai_thr);

    cout << "Set encryption parameters and print" << endl;
    print_parameters(context);

    // KeyGenerator keygen(context);
    // SecretKey secret_key = keygen.secret_key();
    // PublicKey public_key;
    // keygen.create_public_key(public_key);
    // RelinKeys relin_keys;
    // keygen.create_relin_keys(relin_keys);
    // GaloisKeys gal_keys;
    // keygen.create_galois_keys(gal_keys);
    // GaloisKeys gal_keys_boot;

    PhantomSecretKey secret_key(context);
    PhantomPublicKey public_key = secret_key.gen_publickey(context);
    PhantomRelinKey relin_keys = secret_key.gen_relinkey(context);
    // PhantomGaloisKey gal_keys = secret_key.create_galois_keys(context);
    PhantomGaloisKey gal_keys_boot;

    // end

    // Encryptor encryptor(context, public_key);
    // Decryptor decryptor(context, secret_key);
    // CKKSEncoder encoder(context);
    // Evaluator evaluator(context, encoder);
    // size_t slot_count = encoder.slot_count();
    // cout <<slot_count<<endl;
    Encryptor encryptor(&context, &public_key);
    Decryptor decryptor(&context, &secret_key);
    // CKKSEncoder encoder(context);
    PhantomCKKSEncoder phantom_encoder(context);
    // repack the phantom encoder to SEAL style
    Encoder encoder(&context, &phantom_encoder);
    Evaluator evaluator(&context, &phantom_encoder);
    size_t slot_count = encoder.slot_count();

    // prepare for bootstrapping
    //  Bootstrapper bootstrapper(
    //    loge,
    //    logn,
    //    logN - 1,
    //    total_level,
    //    scale,
    //    boundary_K,
    //    deg,
    //    scale_factor,
    //    inverse_deg,
    //    context,
    //    keygen,
    //    encoder,
    //    encryptor,
    //    decryptor,
    //    evaluator,
    //    relin_keys,
    //    gal_keys_boot);

    CKKSEvaluator ckks_evaluator(&context, &public_key, &secret_key, &phantom_encoder, &relin_keys, &gal_keys_boot, scale);

    // add on Aug 18, save GPU memory
    // vector<int> gal_vector;
    // gal_vector.push_back(0);
    // for (int i = 0; i < sparse_slots/num_X; ++i)
    // {
    //     gal_vector.push_back((i * num_X));
    //     // cout << (i * num_X) << " ";
    // }

    // gal_vector.push_back(0); // NEXUS
    // for (int i = 0; i < logN - 1; i++)
    // {
    //     gal_vector.push_back((1 << i));
    // }

    // // keygen.create_galois_keys(gal_vector, gal_keys);
    // ckks_evaluator.decryptor.create_galois_keys_from_steps(gal_vector, gal_keys);
    // gal_keys = secret_key.create_galois_keys(context);

    Bootstrapper bootstrapper(
        loge,
        logn,
        logN - 1,
        total_level,
        scale,
        boundary_K,
        deg,
        scale_factor,
        inverse_deg,
        &ckks_evaluator);

    cout << "preparing bootstrapping..." << endl;
    bootstrapper.prepare_mod_polynomial();

    cout << "Adding Bootstrapping Keys..." << endl;
    vector<int> gal_steps_vector;
    gal_steps_vector.push_back(0);
    for (int i = 0; i < logN - 1; i++) {
        gal_steps_vector.push_back((1 << i));
    }
    bootstrapper.addLeftRotKeys_Linear_to_vector_3(gal_steps_vector);

    // ct-ct rotate steps
    // vector<int> gal_vector;
    // gal_steps_vector.push_back(0);
    // for (int i = 0; i < sparse_slots/num_X; ++i)
    // {
    //     gal_steps_vector.push_back((i * num_X));
    //     // cout << (i * num_X) << " ";
    // }

    // keygen.create_galois_keys(gal_steps_vector, gal_keys_boot);

    // ckks_evaluator.decryptor.create_galois_keys_from_steps(gal_steps_vector, *(ckks_evaluator.galois_keys));
    gal_keys_boot = secret_key.create_galois_keys(context);
    // gal_keys = secret_key.create_galois_keys(context);
    std::cout << "Galois key generated from steps vector." << endl;

    bootstrapper.slot_vec.push_back(logn);

    cout << "Generating Linear Transformation Coefficients..." << endl;
    bootstrapper.generate_LT_coefficient_3();

    // shared-a S2C-first batch pipeline. Chunk size n = 4: at n=4 the full
    // Sh-Galois key set (39 keys, ~26.7 GiB; key size ~ dnum*(n+1) polys)
    // fits the 80GB card next to the 192-wide working set, so in amortized
    // mode keygen becomes a one-time cost.
    // The one-time shared-a key material is prepared lazily at the first
    // bootstrap segment, where a ciphertext at the 4-prime trigger level gives
    // the input chain index.
    // NOTE: pipe.prepare() is intentionally NOT called: prepare_mod_polynomial,
    // slot_vec and generate_LT_coefficient_3 were already done above.
    // Shared-a group size n: default 4, override with env MOAI_SHARE_N (must
    // divide the ciphertext count, e.g. 768 % 8 == 0).
    const int pipe_batch_n = getenv("MOAI_SHARE_N") ? atoi(getenv("MOAI_SHARE_N")) : 4;
    BatchBootstrapper pipe(bootstrapper, ckks_evaluator, pipe_batch_n);
    if (use_shared_a_s2c)
        cout << "shared-a group size n = " << pipe_batch_n << endl;
    if (amortize_shared_keys)
    {
        // 摊销模式(单层): 第1段自举的第1组生成 Sh-Galois 密钥和输出侧格式密钥后,
        // 4 段自举的所有后续组全部复用缓存; 不摊销则每组重新生成。4 段的输入层数
        // 相同(4 素数), 密钥内容同分布, 缓存合法。
        // 预算 30 GiB: n=4 时全部 39 把 Sh-Galois 密钥共 ~26.7 GiB,
        // 80GB 卡上可以全量驻留, keygen 降为一次性开销。
        // Budget override via env MOAI_GKEY_GIB (GiB): n=8 keys are ~1.8x
        // larger (size ∝ n+1) and need ~48 GiB to cache fully.
        const size_t gkey_gib = getenv("MOAI_GKEY_GIB") ? atoi(getenv("MOAI_GKEY_GIB")) : 30;
        pipe.enable_chunk_key_amortization(gkey_gib << 30);
        cout << "Chunk key amortization ENABLED (" << gkey_gib << " GiB galois cache budget)." << endl;
    }

    // pre-bootstrap mod-switch: the original path goes to the bottom (1 prime,
    // C2S-first); the shared-a S2C-first path stops early at lS2C+1 = 4 primes
    auto preswitch_for_bootstrap = [&](vector<PhantomCiphertext> &cts) {
        for (auto &ct : cts)
        {
            if (use_shared_a_s2c)
                while (ct.coeff_modulus_size() > 4)
                    evaluator.mod_switch_to_next_inplace(ct);
            else
                while (context.get_context_data(ct.params_id()).chain_depth() != 0)
                    evaluator.mod_switch_to_next_inplace(ct);
        }
    };

    // one bootstrap segment: original per-ciphertext bootstrap_3, or batched
    // shared-a S2C-first (768 = 96 * 8 or 48 * 16, 192 = 12 * 16; see
    // pipe_batch_n above)
    auto run_bootstrap_segment = [&](vector<PhantomCiphertext> &rtn, vector<PhantomCiphertext> &input) {
        // release the async mempool retained by earlier phases (attention
        // holds ~79GB); without this, bootstrap allocations OOM
        cudaDeviceSynchronize();
        cudaMemPool_t moai_pool;
        cudaDeviceGetDefaultMemPool(&moai_pool, 0);
        cudaMemPoolTrimTo(moai_pool, 0);
        {
            size_t free_b = 0, total_b = 0;
            cudaMemGetInfo(&free_b, &total_b);
            cout << "[boot] segment entry (after trim): GPU free=" << free_b / 1048576.0 << "MB" << endl;
        }
        const size_t n = input.size();
        rtn = vector<PhantomCiphertext>(n);
        if (!use_shared_a_s2c)
        {
            for (size_t i = 0; i < n; ++i)
            {
                bootstrapper.bootstrap_3(rtn[i], input[i]);
                // the async pool only releases cached blocks at sync points;
                // between trims its hoarded dead temporaries (~10-15GB) plus
                // the accumulating full-level outputs in rtn (~29GB total)
                // push the card past 80GB. Trim every 8 ciphertexts.
                if (i % 8 == 7)
                {
                    cudaDeviceSynchronize();
                    cudaMemPoolTrimTo(moai_pool, 0);
                }
                if (i % 64 == 63)
                {
                    size_t free_b = 0, total_b = 0;
                    cudaMemGetInfo(&free_b, &total_b);
                    cout << "[boot] " << i + 1 << "/" << n << " GPU free=" << free_b / 1048576.0 << "MB" << endl;
                }
            }
            return;
        }
        // keygen accounting: shared-a key material is one-time preprocessing
        // (reused across all inputs at this level), so it is measured
        // separately and excluded from the online bootstrap time.
        double seg_keygen = 0;
        if (!pipe.shared_keys_ready)
        {
            cout << "Preparing shared-a key material (one-time)..." << endl;
            struct timeval kg0, kg1;
            gettimeofday(&kg0, NULL);
            pipe.prepare_shared_keys(secret_key, input[0].chain_index());
            gettimeofday(&kg1, NULL);
            seg_keygen += kg1.tv_sec - kg0.tv_sec + (kg1.tv_usec - kg0.tv_usec) / 1000000.0;
        }
        for (size_t base = 0; base < n; base += pipe.batch_n)
        {
            vector<PhantomCiphertext> chunk;
            chunk.reserve(pipe.batch_n);
            for (size_t i = base; i < base + pipe.batch_n; i++)
                chunk.push_back(input[i]);
            vector<PhantomCiphertext> out;
            double k = 0, x = 0;
            pipe.bootstrap_shared_a_s2c_first(out, chunk, k, x);
            seg_keygen += k;
            for (size_t i = 0; i < out.size(); i++)
                rtn[base + i] = std::move(out[i]);
            // same periodic trim as the orig path (every chunk = 16 cts)
            cudaDeviceSynchronize();
            cudaMemPoolTrimTo(moai_pool, 0);
            if ((base / pipe.batch_n) % 4 == 3)
            {
                size_t free_b = 0, total_b = 0;
                cudaMemGetInfo(&free_b, &total_b);
                cout << "[boot] " << base + pipe.batch_n << "/" << n << " GPU free=" << free_b / 1048576.0 << "MB" << endl;
            }
        }
        cout << "[boot] segment keygen (preprocessing, excluded from online time): "
             << seg_keygen << " s" << endl;
        if (amortize_shared_keys)
        {
            auto st = pipe.galois_cache_stats();
            cout << "[boot] galois cache: " << st.first << " keys, "
                 << st.second / 1073741824.0 << " GiB" << endl;
            // release the cache between segments: the phases that follow
            // (FFN at 768 width, LayerNorm2) need the ~26.7 GiB more than the
            // next segment needs cached keys; regeneration is ~0.5s per
            // segment and is accounted as preprocessing above.
            cudaDeviceSynchronize();
            pipe.release_galois_cache();
        }
    };

    struct timeval tstart1, tend1;

    // Multi-layer mode (num_layers > 1, modes layers-orig/layers-sham): run
    // the SAME weights for num_layers layers; layer 0 reads/encrypts the file
    // input as usual, layers >= 1 take the previous layer's final output rtn2
    // (post-4th-bootstrap) as input. The one-time setup above (context, keys,
    // bootstrappers) is shared by all layers.
    vector<PhantomCiphertext> prev_layer_output;
    string dump_suffix;

    for (int layer = 0; layer < num_layers; ++layer)
    {
    dump_suffix = num_layers > 1 ? "_L" + to_string(layer) : "";
    if (num_layers > 1)
    {
        size_t free_b = 0, total_b = 0;
        cudaMemGetInfo(&free_b, &total_b);
        cout << "[L" << layer << "] layer start: GPU free=" << free_b / 1048576.0
             << "MB total=" << total_b / 1048576.0 << "MB" << endl;
    }

    // encode + encrypt
    vector<PhantomCiphertext> enc_ecd_x;
    if (layer == 0)
    {
        enc_ecd_x = batch_input(input_x, num_X, num_row, num_col, scale, context, public_key);
    }
    else
    {
        // previous layer's output: post-bootstrap level (24 primes shared-a /
        // 21 orig), scale 2^46 -- natively at the level the LN1 residual add
        // needs (every bootstrap segment returns at this same fixed level).
        enc_ecd_x = std::move(prev_layer_output);
    }
    vector<int> input_len(num_X, 0);
    input_len[0] = 11;
    vector<int> b_vec = bias_vec(input_len, num_X, num_row);
    // cout <<"Matrix X size = "<<num_row <<" * "<<num_col<<endl;
    // cout <<"Modulus chain index for x: "<< context.get_context_data(enc_ecd_x[0].parms_id())->chain_index()<<endl;

    // NOTE: input_x is kept on the host (only ~200MB) so enc_ecd_x_copy can be
    // re-encrypted right before the residual add; holding the copy on the GPU
    // for the whole attention phase costs num_col * 21 primes ~ 4-16GB and
    // pushes the card into the slow driver-allocation path.
    // Debug helper: decrypt a few ciphertexts and report the magnitude of the
    // valid (masked) slots, to localize where the pipeline loses the signal.
    // All debug dumps (dump_cts / dump_cts_file / SM120-DBG / ATT-DUMP /
    // LN-DUMP) are gated on the MOAI_DUMP env var: set MOAI_DUMP=1 for the
    // per-stage verification output; unset for clean benchmark timing (the
    // decrypt+IO work below is entirely skipped, including its syncs).
    const bool moai_dump = getenv("MOAI_DUMP") != nullptr;
    auto dump_cts = [&](const char *tag, vector<PhantomCiphertext> &v, int maxct) {
        if (!moai_dump)
            return;
        cudaDeviceSynchronize();
        double maxabs = 0.0, sum = 0.0;
        long cnt = 0;
        double fv[4] = {0, 0, 0,         0};
        for (size_t i = 0; i < v.size() && (int)i < maxct; ++i)
        {
            PhantomPlaintext pt;
            decryptor.decrypt(v[i], pt);
            vector<double> r;
            encoder.decode(pt, r);
            for (int ind = 0; ind < slot_count; ++ind)
            {
                if (b_vec[ind] == 1)
                {
                    double a = fabs(r[ind]);
                    if (a > maxabs)
                        maxabs = a;
                    sum += a;
                    if (i == 0 && cnt < 4)
                        fv[cnt] = r[ind];
                    cnt++;
                }
            }
        }
        cout << "[DUMP] " << tag << ": maxabs=" << maxabs << " meanabs=" << (cnt ? sum / cnt : 0.0)
             << " first=[" << fv[0] << "," << fv[	1] << "," << fv[2] << "," << fv[3] << "]"
             << " primes=" << v[0].coeff_modulus_size() << " log2scale=" << log2(v[0].scale()) << endl;
    };


    // Full-tensor dump: write every valid slot of every ciphertext to
    // <tag>_<orig|sham>.txt (one line per ct = one layer dimension), for
    // exact per-stage comparison against the plaintext reference.
    auto dump_cts_file = [&](const char *tag, vector<PhantomCiphertext> &v) {
        if (!moai_dump)
            return;
        cudaDeviceSynchronize();
        const string fname = string(tag) + dump_suffix + (use_shared_a_s2c ? "_sham.txt" : "_orig.txt");
        ofstream fout(fname);
        fout.precision(17);
        for (size_t i = 0; i < v.size(); ++i)
        {
            PhantomPlaintext pt;
            decryptor.decrypt(v[i], pt);
            vector<double> r;
            encoder.decode(pt, r);
            bool firstv = true;
            for (int ind = 0; ind < slot_count; ++ind)
            {
                if (b_vec[ind] == 1)
                {
                    if (!firstv)
                        fout << " ";
                    fout << r[ind];
                    firstv = false;
                }
            }
            fout << "\n";
        }
        fout.close();
        cout << "[DUMP-FILE] " << fname << " (" << v.size() << " cts)" << endl;
    };

    dump_cts("input", enc_ecd_x, 2);
    dump_cts_file("stage_input", enc_ecd_x);

    if (layer == 0)
    {
        // mod switch to remaining level
        // #pragma omp parallel for

        for (int i = 0; i < num_col; ++i)
        {
            for (int j = 0; j < boot_level + (remaining_level - remaining_level_att); ++j)
            {
                evaluator.mod_switch_to_next_inplace(enc_ecd_x[i]);
            }
        }

        // mod switch to next level
        // #pragma omp parallel for

        for (int i = 0; i < num_col; ++i)
        {
            evaluator.mod_switch_to_next_inplace(enc_ecd_x[i]);
        }
    }
    // layers >= 1: NO preswitch. enc_ecd_x is the previous layer's bootstrap
    // output (24 primes shared-a / 21 orig) -- above layer 0's 18-prime
    // attention entry. The attention block's internal absolute-level
    // mod-switches (V path -> chain_depth 6, softmax pre-bootstrap preswitch)
    // absorb the extra primes, and keeping the native level lets enc_ecd_x
    // double as the LN1 residual (boot1 returns at this same fixed level),
    // avoiding a second live full-level ciphertext vector.

    cout << "Modulus chain index before attention block: " << context.get_context_data(enc_ecd_x[0].params_id()).chain_depth() << endl;
    if (num_layers > 1)
        cout << "[L" << layer << "] attention input: primes=" << enc_ecd_x[0].coeff_modulus_size()
             << " log2scale=" << log2(enc_ecd_x[0].scale()) << endl;

    vector<vector<PhantomCiphertext>> att_block(num_head);

    gettimeofday(&tstart1, NULL);

    for (int i = 0; i < num_head; ++i)
    {
        // iter = 13 (was 16): the softmax inverse is a geometric series whose
        // truncation error after k iterations is |1-sum|^(2^(k+1)); with the
        // calibrated shift the residual sum is in [0.13, 0.34] (192) / ~0.1
        // (768), so 13 iterations already drive the error to ~0. Freeing 3
        // levels lets softmax_boot keep 3 extra levels after its internal
        // bootstrap (see the iter+1+6 bound there), lifting softmax output
        // from 3 to 6 primes so the attention output reaches the bootstrap
        // with exactly 4 primes -- required by the shared-a S2C-first path.
        // minus_index override: the table value (layer 10 -> 11) sinks
        // exp(x-11) to ~1e-5, below the FHE noise floor (~1e-4), for the
        // small 192-slice scores; 4.5 keeps the row sums in [0.13, 0.34].
        att_block[i] = single_att_block(enc_ecd_x, WQ[i], WK[i], WV[i], bQ[i], bK[i], bV[i],
                                        b_vec, num_input, context, relin_keys, gal_keys_boot, bootstrapper, num_X, secret_key, 13, 10,
                                        num_col == 192 ? 4.5 : -1.0);
        // release per-head temporaries held by the async pool: retention grew
        // ~1GB/head and head 12 OOM'd in softmax with 274MB free.
        cudaDeviceSynchronize();
        cudaMemPoolTrimTo(moai_pool, 0);
        /*
        cout <<"Decrypt + decode result of ";
        cout <<i+1<<"-th head: "<<endl;
        for (int j = 0; j < att_block[i].size(); ++j){
            Plaintext plain_result;
            decryptor.decrypt(att_block[i][j], plain_result);
            vector<double> result;
            encoder.decode(plain_result, result);
            cout <<j+1<<"-th ciphertext: ";
            for (int ind = 0 ; ind < slot_count ; ++ind){
                if(b_vec[ind] == 1){
                    cout <<result[ind]<<" ";
                }
            }
            cout <<endl;
        }
    */
    }

    gettimeofday(&tend1, NULL);
    double att_block_time = tend1.tv_sec - tstart1.tv_sec + (tend1.tv_usec - tstart1.tv_usec) / 1000000.0;
    cout << "Attention block time = " << att_block_time << endl;
    append_csv_row("../single_layer_results.csv", "Attention Block", att_block_time);
    moai_sync_check("after-attention");
    // cout <<"Modulus chain index for the result: "<< context.get_context_data(att_block[2][0].params_id()).chain_depth()<<endl;
// }
/*
    cout <<"Decrypt + decode result: "<<endl;
    //decrypt and decode
    for (int k = 0; k < num_head; ++k){
        //cout <<k+1<<"-th head: "<<endl;
        for (int i = 0; i < att_block[k].size(); ++i){
            Plaintext plain_result;
            decryptor.decrypt(att_block[k][i], plain_result);
            vector<double> result;
            encoder.decode(plain_result, result);
            cout <<i+1<<"-th ciphertext: ";
            for (int ind = 0 ; ind < slot_count ; ++ind){
                if(b_vec[ind] == 1){
                    cout <<result[ind]<<", ";
                }
            }
            cout <<endl;
        }
    }


    cout <<endl;

*/
// delete enc_ecd_x
    moai_sync_check("before-swap-enc_ecd_x");
    if (layer == 0)
        vector<PhantomCiphertext>().swap(enc_ecd_x);  // layers >= 1: enc_ecd_x is the LN1 residual, freed after the add

    int output_size = att_block[0].size();

    vector<PhantomCiphertext> att_output(num_head*output_size);

    for (int i = 0; i < num_head; ++i){
        for (int j = 0 ; j < output_size ; ++j){
            att_output[i*output_size+j] = att_block[i][j];
            // att_output[i*output_size+j] = att_block[0][j];
        }
    }
    moai_sync_check("after-concat");

    cout <<"Concatenation. size of output of attention block = "<<num_head<<" * "<<output_size<<" = "<<att_output.size()<<endl;

    // --- forensics: validate every buffer that the swap below is about to free ---
    {
        std::set<const void *> seen;
        std::set<cudaStream_t> live_streams;
        for (auto &w : stream_pool)
            live_streams.insert(w.get_stream());
        int dup = 0, bad = 0, dead_stream = 0;
        for (size_t i = 0; i < att_block.size(); ++i)
            for (size_t j = 0; j < att_block[i].size(); ++j)
            {
                auto &c = att_block[i][j];
                const void *p = c.data();
                size_t n = c.size() * c.coeff_modulus_size() * c.poly_modulus_degree();
                cudaStream_t s = c.data_ptr().get_stream();
                if (!p)
                    continue;
                if (!seen.insert(p).second)
                { dup++; std::cerr << "[forensics] DUP ptr " << p << " at (" << i << "," << j << ") n=" << n << std::endl; }
                cudaPointerAttributes attr;
                cudaError_t pe = cudaPointerGetAttributes(&attr, p);
                if (pe != cudaSuccess)
                { bad++; std::cerr << "[forensics] BAD ptr " << p << " at (" << i << "," << j << ") n=" << n
                                   << " err=" << cudaGetErrorString(pe) << std::endl; cudaGetLastError(); }
                if (s && live_streams.find(s) == live_streams.end())
                { dead_stream++; std::cerr << "[forensics] UNKNOWN stream " << s << " at (" << i << "," << j << ") ptr=" << p << std::endl; }
            }
        std::cerr << "[forensics] att_block: " << seen.size() << " unique ptrs, dup=" << dup
                  << ", bad=" << bad << ", unknown_stream=" << dead_stream << std::endl;
    }

    vector<vector<PhantomCiphertext>>().swap(att_block);
    // the concat copies above were enqueued on each source ciphertext's
    // producer stream; sync before the selfoutput matmul consumes att_output.
    moai_sync_check("after-swap-att_block");
    dump_cts_file("stage_attconcat", att_output);
    double selfoutput_time;
    //att_output * selfoutput + selfoutput_bias

    // [SM120-DBG] manual trace of selfoutput output column 0, v2: dump every j,
    // on explosion also dump the j-th product term and att_output[j] itself.
    // NOTE: this re-runs a full 192-term column accumulation + decrypt per j --
    // expensive, gated on MOAI_DUMP.
    if (moai_dump)
    {
        auto dbg_maxabs = [&](PhantomCiphertext &c, const char *what, int j) {
            PhantomPlaintext dpt;
            decryptor.decrypt(c, dpt);
            vector<double> dv;
            encoder.decode(dpt, dv);
            double mx = 0;
            for (auto &vv : dv) mx = max(mx, fabs(vv));
            cout << "[SM120-DBG] " << what << " j=" << j << " maxabs=" << mx
                 << " primes=" << c.coeff_modulus_size() << " log2scale=" << log2(c.scale()) << endl;
            return mx;
        };
        PhantomCiphertext dbg_acc;
        bool exploded = false;
        for (int j = 0; j < num_col; ++j)
        {
            PhantomPlaintext ecd_w;
            encoder.encode(selfoutput[j][0], att_output[j].params_id(), att_output[j].scale(), ecd_w);
            if (j == 0)
            {
                evaluator.multiply_plain(att_output[0], ecd_w, dbg_acc);
            }
            else
            {
                PhantomCiphertext tmp;
                evaluator.multiply_plain(att_output[j], ecd_w, tmp);
                evaluator.add_inplace(dbg_acc, tmp);
            }
            double mx = dbg_maxabs(dbg_acc, "col0-acc", j);
            if (mx > 10.0 && !exploded)
            {
                exploded = true;
                cout << "[SM120-DBG] EXPLOSION at j=" << j << endl;
                // the j-th product term alone
                PhantomPlaintext ecd_w2;
                encoder.encode(selfoutput[j][0], att_output[j].params_id(), att_output[j].scale(), ecd_w2);
                PhantomCiphertext tmp2;
                evaluator.multiply_plain(att_output[j], ecd_w2, tmp2);
                dbg_maxabs(tmp2, "term", j);
                dbg_maxabs(att_output[j], "att_output", j);
                // re-run previous accumulation step for reproducibility check
                PhantomPlaintext ecd_w3;
                encoder.encode(selfoutput[j-1][0], att_output[j-1].params_id(), att_output[j-1].scale(), ecd_w3);
                PhantomCiphertext tmp3;
                evaluator.multiply_plain(att_output[j-1], ecd_w3, tmp3);
                dbg_maxabs(tmp3, "term", j-1);
                dbg_maxabs(att_output[j-1], "att_output", j-1);
            }
        }
        if (!exploded)
            cout << "[SM120-DBG] col0 trace clean, final maxabs ok" << endl;
    }
    vector<PhantomCiphertext> att_selfoutput = ct_pt_matrix_mul_wo_pre_large_single(att_output, selfoutput, num_col, num_col, num_col, context, selfoutput_time);
    dump_cts("selfoutput-raw", att_selfoutput, 2);
    if (moai_dump)
    {
        // [SM120-DBG] garbage-slot index map for selfoutput-raw ct0/ct1
        for (int c = 0; c < 2; ++c)
        {
            PhantomPlaintext dpt;
            decryptor.decrypt(att_selfoutput[c], dpt);
            vector<double> dv;
            encoder.decode(dpt, dv);
            long total = 0;
            cout << "[SM120-DBG] raw ct" << c << " bad-slot(|v|>1e3) idx:";
            for (size_t i = 0; i < dv.size(); ++i)
                if (fabs(dv[i]) > 1e3)
                {
                    if (total < 40) cout << " " << i;
                    total++;
                }
            cout << "  total_bad=" << total << "/" << dv.size() << endl;
            if (total > 0)
            {
                for (size_t i = 0; i < dv.size(); ++i)
                    if (fabs(dv[i]) > 1e3) { cout << "[SM120-DBG]   sample idx " << i << " = " << dv[i] << endl; break; }
            }
        }
    }
    if (moai_dump)
    {
        // [SM120-DBG] scan ALL selfoutput columns for garbage (masked slots)
        int dirty = 0;
        for (size_t c = 0; c < att_selfoutput.size(); ++c)
        {
            PhantomPlaintext dpt;
            decryptor.decrypt(att_selfoutput[c], dpt);
            vector<double> dv;
            encoder.decode(dpt, dv);
            double mx = 0;
            for (int ind = 0; ind < slot_count; ++ind)
                if (b_vec[ind] == 1)
                    mx = max(mx, fabs(dv[ind]));
            if (mx > 10.0)
            {
                if (dirty < 12)
                    cout << "[SM120-DBG] dirty selfoutput col " << c << " maxabs=" << mx << endl;
                dirty++;
            }
        }
        cout << "[SM120-DBG] selfoutput dirty columns: " << dirty << "/" << att_selfoutput.size() << endl;
    }

    int att_selfoutput_size = att_selfoutput.size();
    //cout <<"num of ct in att_selfoutput = "<<att_selfoutput_size<<endl;
    for (int i = 0; i < num_col; ++i){
        PhantomPlaintext ecd_self_bias;
        vector<double> self_bias_vec(slot_count,0);
        for (int j = 0; j < slot_count; ++j){
            if(b_vec[j] == 1){
                self_bias_vec[j] = selfoutput_bias[i];
            }
        }
        encoder.encode(self_bias_vec, att_selfoutput[i].params_id(), att_selfoutput[i].scale(), ecd_self_bias);
        evaluator.mod_switch_to_inplace(ecd_self_bias, att_selfoutput[i].params_id());
        att_selfoutput[i].scale() = scale;
        ecd_self_bias.scale() = scale;
        evaluator.add_plain_inplace(att_selfoutput[i],ecd_self_bias);
    }

    // att_output is dead once att_selfoutput is computed; free its ~4GB
    // before the bootstrap segment starts filling rtn with full-level cts.
    vector<PhantomCiphertext>().swap(att_output);

    cout <<"selfoutput time = "<<selfoutput_time<<endl;
    append_csv_row("../single_layer_results.csv", "SelfOutput", selfoutput_time);
    cout <<"Modulus chain index for the result: "<< context.get_context_data(att_selfoutput[0].params_id()).chain_depth()<<endl;
    dump_cts("selfoutput", att_selfoutput, 2);
    dump_cts_file("stage_selfoutput", att_selfoutput);

/*
    cout <<"Decrypt + decode result of selfoutput: "<<endl;
    //decrypt and decode
    for (int k = 0; k < att_selfoutput.size(); ++k){
        cout <<k+1<<"-th ciphertext: ";
        Plaintext plain_result;
        decryptor.decrypt(att_selfoutput[k], plain_result);
        vector<double> result;
        encoder.decode(plain_result, result);
        for (int ind = 0 ; ind < slot_count ; ++ind){
            if(b_vec[ind] == 1){
                cout <<result[ind]<<", ";
            }
        }
        cout <<endl;
    }
*/
    //mod switch the ciphertext  to the lowest layer
    preswitch_for_bootstrap(att_selfoutput);
    dump_cts("boot1-in", att_selfoutput, 2);

    vector<PhantomCiphertext> rtn;

    //cout<<"bootstrapping start. "<<endl;

    gettimeofday(&tstart1,NULL);

    // #pragma omp parallel for

    run_bootstrap_segment(rtn, att_selfoutput);

    gettimeofday(&tend1,NULL);
    double boot_time = tend1.tv_sec-tstart1.tv_sec+(tend1.tv_usec-tstart1.tv_usec)/1000000.0;
    cout <<"bootstrapping time = "<<boot_time<<endl;
    append_csv_row("../single_layer_results.csv", "1st Bootstrapping", boot_time);
    cout <<"Modulus chain index after bootstrapping: "<< context.get_context_data(rtn[0].params_id()).chain_depth()<<endl;
    dump_cts("boot1-out", rtn, 2);
    dump_cts_file("stage_boot1", rtn);

    //for (int i = 0; i < rtn.size(); ++i){
    //    evaluator.mod_switch_to_next_inplace(rtn[i]);
    //}
    //cout <<"Modulus chain index before layernorm: "<< context.get_context_data(rtn[0].parms_id())->chain_index()<<endl;

    vector<PhantomCiphertext>().swap(att_selfoutput);

    /*
    //decrypt and decode
    cout <<"Decrypt + decode result of bootstrapping: "<<endl;
    for (int i = 0; i < rtn.size(); ++i){
        Plaintext plain_result;
        decryptor.decrypt(rtn[i], plain_result);
        vector<double> result;
        encoder.decode(plain_result, result);
        cout <<i+1<<"-th ciphertext: ";
        for (int ind = 0 ; ind < slot_count ; ++ind){
            if(b_vec[ind] == 1){
                cout <<result[ind]<<", ";
            }
        }
        cout <<endl;
    }

    cout <<endl;
    */
    //rtn+enc_ecd_x_copy
    // re-encrypt the residual copy now (see the NOTE near batch_input): top
    // level, then drop to the post-bootstrap level of rtn -- 21 primes for the
    // original bootstrap_3, 24 for shared-a S2C-first (returns 3 more primes).
    // The copy must NOT be dropped below rtn's level: mod_switch_to_inplace
    // cannot raise a ciphertext to a higher params_id.
    gettimeofday(&tstart1,NULL);
    vector<PhantomCiphertext> enc_ecd_x_copy;
    if (layer == 0)
    {
        enc_ecd_x_copy = batch_input(input_x, num_X, num_row, num_col, scale, context, public_key);
        vector<vector<vector<double>>>().swap(input_x);
        const int residual_drop = boot_level - (use_shared_a_s2c ? 3 : 0);
        for (int i = 0; i < num_col; ++i) {
            for (int j = 0; j < residual_drop; ++j){
                evaluator.mod_switch_to_next_inplace(enc_ecd_x_copy[i]);
            }
        }
    }
    // layers >= 1: enc_ecd_x still holds the untouched layer input (the
    // attention block only reads it) at the native post-bootstrap level, which
    // is exactly rtn's level -- use it directly as the residual.
    vector<PhantomCiphertext> &residual_src = (layer == 0) ? enc_ecd_x_copy : enc_ecd_x;

    // #pragma omp parallel for

    for (int i = 0; i < num_col; ++i){
        if (residual_src[i].params_id() != rtn[i].params_id())
            evaluator.mod_switch_to_inplace(residual_src[i], rtn[i].params_id());
        evaluator.add_inplace(rtn[i],residual_src[i]);
    }

    // the residual source is dead once added in; free it (and, for layers
    // >= 1, the layer input it aliases) before layernorm's temporaries.
    vector<PhantomCiphertext>().swap(enc_ecd_x_copy);
    vector<PhantomCiphertext>().swap(enc_ecd_x);

    vector<PhantomCiphertext> layernorm_selfoutput = layernorm(rtn,layernorm1_gamma,layernorm1_beta, b_vec,
        context,relin_keys,secret_key);

    gettimeofday(&tend1,NULL);
    double layernorm_time = tend1.tv_sec-tstart1.tv_sec+(tend1.tv_usec-tstart1.tv_usec)/1000000.0;
    cout <<"layernorm time = "<<layernorm_time<<endl;
    append_csv_row("../single_layer_results.csv", "LayerNorm1", layernorm_time);
    cout <<"Modulus chain index after layernorm: "<< context.get_context_data(layernorm_selfoutput[0].params_id()).chain_depth()<<endl;
    dump_cts("ln1-out", layernorm_selfoutput, 2);
    dump_cts_file("stage_ln1", layernorm_selfoutput);
/*
    cout <<"Decrypt + decode result of layernorm: "<<endl;
    for (int i = 0; i < layernorm_selfoutput.size(); ++i){
        Plaintext plain_result;
        decryptor.decrypt(layernorm_selfoutput[i], plain_result);
        vector<double> result;
        encoder.decode(plain_result, result);
        cout <<i+1<<"-th ciphertext: ";
        for (int ind = 0 ; ind < slot_count ; ++ind){
            if(b_vec[ind] == 1){
                cout <<result[ind]<<", ";
            }
            else if(result[ind] >= 0.0001){
                cout <<"( "<<ind<<", "<<result[ind]<<"). ";
                continue;
            }
        }
        cout <<endl;
    }

    cout <<endl;
*/
    //bootstrapping
    int layernorm_selfoutput_size = layernorm_selfoutput.size();
    //mod switch the ciphertext to the lowest layer
    preswitch_for_bootstrap(layernorm_selfoutput);

    vector<PhantomCiphertext> boot_layer(layernorm_selfoutput_size);

    //cout<<"bootstrapping start. "<<endl;

    gettimeofday(&tstart1,NULL);

    // #pragma omp parallel for

    run_bootstrap_segment(rtn, layernorm_selfoutput);

    // free the bootstrap segment input before the residual copy below; at 768
    // width every live full-level ciphertext vector is ~17GB of the 96GB
    // budget, so dead inputs must be released before the copy starts.
    vector<PhantomCiphertext>().swap(layernorm_selfoutput);

    // FFN input level = 13 primes (raised from the upstream 10): the FFN chain
    // consumes exactly 9 levels (inter 1 + gelu 7 + final 1), so the 3rd
    // bootstrap segment receives exactly 4 primes, the minimum the shared-a
    // S2C-first bootstrap needs. bootstrap_3 returns 21 primes (drop 8),
    // shared-a S2C-first returns 24 (drop 11).
    // The residual copy and the drop are fused into one loop so rtn[i] shrinks
    // (mod_switch allocates a smaller buffer, freeing the dropped limbs) as
    // boot_layer grows -- copying all of rtn first peaks at two full-level
    // vectors at once and OOMs a 96GB card at 768 width.
    const int post_boot_drop = use_shared_a_s2c ? 11 : 8;
    for (int i = 0; i < layernorm_selfoutput_size; ++i)
    {
        boot_layer[i] = rtn[i]; // LN2 residual, kept at the post-bootstrap level
        for (int j = 0; j < post_boot_drop; ++j)
            evaluator.mod_switch_to_next_inplace(rtn[i]);
    }

    gettimeofday(&tend1,NULL);
    double boot_time2 = tend1.tv_sec-tstart1.tv_sec+(tend1.tv_usec-tstart1.tv_usec)/1000000.0;
    cout <<"bootstrapping time = "<<boot_time2<<endl;
    append_csv_row("../single_layer_results.csv", "2nd Bootstrapping", boot_time2);
    //cout <<"Modulus chain index after bootstrapping: "<< context.get_context_data(rtn[0].parms_id())->chain_index()<<endl;
    cout <<"Modulus chain index after bootstrapping: "<< context.get_context_data(boot_layer[0].params_id()).chain_depth()<<endl;
    dump_cts("boot2-out", rtn, 2);
    dump_cts_file("stage_boot2", rtn);

    // [768-mem] park the LN2 residual in host RAM through the FFN phase: 768
    // full-level ciphertexts are ~17GB on device and are not touched again
    // until the residual add after the 3rd bootstrap segment. All boot_layer
    // ciphertexts share the same level/size, so one metadata record suffices.
    vector<vector<uint64_t>> boot_layer_host(boot_layer.size());
    size_t bl_chain = boot_layer[0].chain_index();
    size_t bl_size = boot_layer[0].size();
    double bl_scale = boot_layer[0].scale();
    bool bl_ntt = boot_layer[0].is_ntt_form();
    {
        const auto &dstream = phantom::util::global_variables::default_stream->get_stream();
        size_t host_bytes = 0;
        for (size_t i = 0; i < boot_layer.size(); ++i)
        {
            size_t n = boot_layer[i].size() * boot_layer[i].coeff_modulus_size() * boot_layer[i].poly_modulus_degree();
            boot_layer_host[i].resize(n);
            cudaMemcpyAsync(boot_layer_host[i].data(), boot_layer[i].data(), n * sizeof(uint64_t),
                            cudaMemcpyDeviceToHost, dstream);
            boot_layer[i] = PhantomCiphertext(); // release the device buffer
            host_bytes += n * sizeof(uint64_t);
        }
        cudaStreamSynchronize(dstream);
        cout << "[mem] LN2 residual offloaded to host: " << host_bytes / 1073741824.0 << " GiB" << endl;
    }

/*
    //decrypt and decode
    cout <<"Decrypt + decode result of bootstrapping: "<<endl;
    for (int i = 0; i < 10; ++i){
        Plaintext plain_result;
        decryptor.decrypt(rtn[i], plain_result);
