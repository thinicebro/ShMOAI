    for (int i = 0; i < final_output.size(); ++i){
        Plaintext plain_result;
        decryptor.decrypt(final_output[i], plain_result);
        vector<double> result;
        encoder.decode(plain_result, result);
        cout <<i+1<<"-th ciphertext: ";
        int iscout = 0;
        for (int ind = 0 ; ind < slot_count ; ++ind){
            if(b_vec[ind] == 1){
                cout <<result[ind]<<", ";
            }
            else if(result[ind] >= 0.001){
                if(iscout == 0){
                    cout <<"( "<<ind<<", "<<result[ind]<<"). ";
                    iscout ++;
                }
            }
        }
        cout <<endl;
    }

    cout <<endl;
*/
    //bootstrapping
    //int final_output_size = final_output.size();
    //mod switch the ciphertext to the lowest layer
    preswitch_for_bootstrap(final_output);

    //cout<<"bootstrapping start. "<<endl;
    vector<PhantomCiphertext> rtn2(num_col);
    gettimeofday(&tstart1,NULL);

    // #pragma omp parallel for

    run_bootstrap_segment(rtn2, final_output);

    gettimeofday(&tend1,NULL);
    double boot_time3 = tend1.tv_sec-tstart1.tv_sec+(tend1.tv_usec-tstart1.tv_usec)/1000000.0;
    cout <<"bootstrapping time = "<<boot_time3<<endl;
    append_csv_row("../single_layer_results.csv", "3rd Bootstrapping", boot_time3);
    cout <<"Modulus chain index after bootstrapping: "<< context.get_context_data(rtn2[0].params_id()).chain_depth()<<endl;
    dump_cts("boot3-out", rtn2, 2);
    dump_cts_file("stage_boot3", rtn2);

   // for (int i = 0; i < rtn2.size(); ++i){
    //    evaluator.mod_switch_to_next_inplace(rtn2[i]);
   // }
    //cout <<"Modulus chain index before layernorm: "<< context.get_context_data(rtn2[0].parms_id())->chain_index()<<endl;

    vector<PhantomCiphertext>().swap(final_output);

    cout <<"LayerNorm start. "<<endl;
    gettimeofday(&tstart1,NULL);

    //rtn+enc_ecd_x_copy
    // [768-mem] pull the LN2 residual back from host RAM (see the offload
    // right after the 2nd bootstrap segment).
    {
        const auto &dstream = phantom::util::global_variables::default_stream->get_stream();
        for (size_t i = 0; i < boot_layer.size(); ++i)
        {
            boot_layer[i].resize(context, bl_chain, bl_size, dstream);
            cudaMemcpyAsync(boot_layer[i].data(), boot_layer_host[i].data(),
                            boot_layer_host[i].size() * sizeof(uint64_t), cudaMemcpyHostToDevice, dstream);
            boot_layer[i].set_scale(bl_scale);
            boot_layer[i].set_ntt_form(bl_ntt);
        }
        cudaStreamSynchronize(dstream);
        vector<vector<uint64_t>>().swap(boot_layer_host);
    }
    // #pragma omp parallel for

    for (int i = 0; i < num_col; ++i){
        evaluator.mod_switch_to_inplace(boot_layer[i], rtn2[i].params_id());
        evaluator.add_inplace(rtn2[i],boot_layer[i]);
    }
/*
    cout <<"Decrypt + decode result before layernorm: "<<endl;
    for (int i = 0; i < 5; ++i){
        Plaintext plain_result;
        decryptor.decrypt(rtn2[i], plain_result);
        vector<double> result;
        encoder.decode(plain_result, result);
        cout <<i+1<<"-th ciphertext: ";
        for (int ind = 0 ; ind < slot_count ; ++ind){
            if(b_vec[ind] == 1){
                cout <<result[ind]<<", ";
            }
        }
        cout <<endl;
    }

    cout <<endl;
*/
    dump_cts_file("stage_ln2in", rtn2);
    // 192 宽用 var_pow=2（对齐 layernorm 约定，var≈210-260 落在 initGuess
    // 精确收敛区）；768 保持上游 var_pow=3（var=popvar，避免大值溢出猜测区间）。
    vector<PhantomCiphertext> layernorm_finaloutput = layernorm2(rtn2,layernorm2_gamma,layernorm2_beta,b_vec,
        context,relin_keys,secret_key, num_col == 192 ? 2 : 3);

    gettimeofday(&tend1,NULL);
    double layernorm_time2 = tend1.tv_sec-tstart1.tv_sec+(tend1.tv_usec-tstart1.tv_usec)/1000000.0;
    cout <<"layernorm time = "<<layernorm_time2<<endl;
    append_csv_row("../single_layer_results.csv", "LayerNorm2", layernorm_time2);
    cout <<"Modulus chain index after layernorm: "<< context.get_context_data(layernorm_finaloutput[0].params_id()).chain_depth()<<endl;
    dump_cts("layernorm2-out", layernorm_finaloutput, 2);
    dump_cts_file("stage_ln2", layernorm_finaloutput);
    vector<PhantomCiphertext>().swap(rtn);

    // cout <<"Decrypt + decode result of one layer: "<<endl;
    // for (int i = 0; i < layernorm_finaloutput.size(); ++i){
    //     PhantomPlaintext plain_result;
    //     decryptor.decrypt(layernorm_finaloutput[i], plain_result);
    //     vector<double> result;
    //     encoder.decode(plain_result, result);
    //     cout <<i+1<<"-th ciphertext: ";
    //     for (int ind = 0 ; ind < slot_count ; ++ind){
    //         if(b_vec[ind] == 1){
    //             cout <<result[ind]<<", ";
    //         }
    //     }
    //     cout <<endl;
    // }

    // cout <<endl;

    //bootstrapping
    int layernorm2_size = layernorm_finaloutput.size();
    //mod switch the ciphertext to the lowest layer
    preswitch_for_bootstrap(layernorm_finaloutput);

    //cout<<"bootstrapping start. "<<endl;
    gettimeofday(&tstart1,NULL);

    // #pragma omp parallel for

    run_bootstrap_segment(rtn2, layernorm_finaloutput);

    gettimeofday(&tend1,NULL);
    double boot_time4 = tend1.tv_sec-tstart1.tv_sec+(tend1.tv_usec-tstart1.tv_usec)/1000000.0;
    cout <<"bootstrapping time = "<<boot_time4<<endl;
    append_csv_row("../single_layer_results.csv", "4th Bootstrapping", boot_time4);
    cout <<"Modulus chain index after bootstrapping: "<< context.get_context_data(rtn2[0].params_id()).chain_depth()<<endl;
    dump_cts("boot4-out", rtn2, 2);
    dump_cts_file("stage_boot4", rtn2);

    vector<PhantomCiphertext>().swap(layernorm_finaloutput);
/*
    cout <<"Decrypt + decode result of one layer: "<<endl;
    for (int i = 0; i < rtn2.size(); ++i){
        Plaintext plain_result;
        decryptor.decrypt(rtn2[i], plain_result);
        vector<double> result;
        encoder.decode(plain_result, result);
        cout <<i+1<<"-th ciphertext: ";
        for (int ind = 0 ; ind < slot_count ; ++ind){
            if(b_vec[ind] == 1){
                cout <<result[ind]<<", ";
            }
        }
        cout <<endl;
    }

    cout <<endl;
*/
    double total_time = att_block_time+selfoutput_time+layernorm_time+inter_time+gelu_time+final_time+layernorm_time2
    +boot_time+boot_time2+boot_time3+boot_time4;
    const string ltag = num_layers > 1 ? "[L" + to_string(layer) + "] " : "";
    const string csv_ltag = num_layers > 1 ? " [L" + to_string(layer) + "]" : "";
    cout <<ltag<<"Total time for one layer: "<<total_time<<", amortized time: "<<total_time/256.0<<endl;
    append_csv_row("../single_layer_results.csv", "Total time for one layer" + csv_ltag, total_time);
    append_csv_row("../single_layer_results.csv", "Amortized time" + csv_ltag, total_time/256.0);

    // Correctness check: decrypt the final layer output and dump the masked
    // (valid) slots, so the orig and shared-a paths can be cross-validated.
    {
        const string dump_name = string("final") + dump_suffix + (use_shared_a_s2c ? "_sham.txt" : "_orig.txt");
        ofstream fout(dump_name);
        fout.precision(17);
        double max_abs = 0.0;
        for (size_t i = 0; i < rtn2.size(); ++i)
        {
            PhantomPlaintext plain_result;
            decryptor.decrypt(rtn2[i], plain_result);
            vector<double> result;
            encoder.decode(plain_result, result);
            for (int ind = 0; ind < slot_count; ++ind)
            {
                if (b_vec[ind] == 1)
                {
                    fout << result[ind] << " ";
                    if (fabs(result[ind]) > max_abs)
                        max_abs = fabs(result[ind]);
                }
            }
            fout << endl;
        }
        fout.close();
        cout << "Final decrypted output written to " << dump_name
             << " (" << rtn2.size() << " cts, max abs = " << max_abs << ")" << endl;
        append_csv_row("../single_layer_results.csv", "Final output max abs" + csv_ltag, max_abs);
    }

    // feed this layer's output to the next iteration and release the rest:
    // every large ciphertext vector above is loop-scoped and dies here; move
    // rtn2 out, then trim the async pool so each layer starts clean.
    if (layer + 1 < num_layers)
        prev_layer_output = std::move(rtn2);
    vector<PhantomCiphertext>().swap(rtn2);
    if (num_layers > 1)
    {
        cudaDeviceSynchronize();
        cudaMemPoolTrimTo(moai_pool, 0);
        size_t free_b = 0, total_b = 0;
        cudaMemGetInfo(&free_b, &total_b);
        cout << "[L" << layer << "] layer end (after trim): GPU free=" << free_b / 1048576.0
             << "MB total=" << total_b / 1048576.0 << "MB" << endl;
    }
    } // end multi-layer loop

}
